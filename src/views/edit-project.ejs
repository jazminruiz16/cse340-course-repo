<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
            <div class="form-group">
                <label for="name">Project Name</label>
                <input type="text" id="title" name="title" value="<%= projectDetails.title %>" maxlength="150"
                    required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500"
                    required><%= projectDetails.description %></textarea>
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" 
                 value="<%= projectDetails.date ? new Date(projectDetails.date).toISOString().split('T')[0] : '' %>" required/>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <textarea id="location" name="location" maxlength="500" required><%= projectDetails.location %></textarea>
            </div>

            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="<%=projectDetails.organization_id %>"><%=projectDetails.organization_name %></option>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>">
                            <%= org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>


            <button class="button2" type="submit">Update project</button>
        </form>

    </main>
    <%- include('partials/footer') %>