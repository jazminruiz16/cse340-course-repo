<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Here are our service projects categories:</p>
        <ul>
            
            <% categories.forEach(category=> { %>
                <li><img src="/images/unityserve-logo.png" alt="<%= category.category_name %> logo"><a href="/category/<%= category.category_id %>"><strong>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.category_name %>
                        </a>
                    </strong>
                </li>
                <% }); %>

            
        </ul>
        <p><a href="/new-category">Add a new category</a></p>
    </main>

    <%- include('partials/footer') %>