<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Here are our service projects categories:</p>
        <ul>
            
            <% categories.forEach(category=> { %>
                <li><img src="/images/unityserve-logo.png" alt="<%= category.category_name %> logo"><strong>
                        <%= category.category_name %>
                    </strong>
                </li>
                <% }); %>

            
        </ul>
    </main>

    <%- include('partials/footer') %>