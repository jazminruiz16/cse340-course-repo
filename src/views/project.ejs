<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <h2><%= projectDetails.title %></h2>
        <p><strong>Description: </strong><%= projectDetails.description %></p>
        <p>
            <strong>Date: </strong><%= projectDetails.date.toLocaleDateString('en-US', { month: 'long' , day: 'numeric' , year: 'numeric' }) %>
        </p>
        <p><strong>Location: </strong><%= projectDetails.location %></p>
        <p><strong>Partner organization for the service project:</strong> <a href="/organization/<%= projectDetails.organization_id %>">
            <%= projectDetails.organization_name %></a></p>
        


    </main>

    <%- include('partials/footer') %>